uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/juergen/lib/qt5/designer/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/juergen/lib/qt5/designer/ 


