QMAKE_TARGET  = devicesplugin
DESTDIR       = ../../lib/qt5/designer/
TARGET        = libdevicesplugin.so
TARGETD       = libdevicesplugin.so


first: all
####### Build rules

../../lib/qt5/designer/$(TARGET):  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../../lib/qt5/designer/ || mkdir -p ../../lib/qt5/designer/
	-$(DEL_FILE) $(TARGET)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-$(MOVE) $(TARGET) ../../lib/qt5/designer/ 



qmake: FORCE
	@$(QMAKE) -o Makefile.Debug qvintage.pro -spec linux-g++ CONFIG+=debug

qmake_all: FORCE


all: Makefile.Debug ../../lib/qt5/designer/$(TARGET)

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents icons.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib64/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents devices.h LED/LEDPlugin.h SEG7/SEG7Plugin.h SWITCH/SWITCHPlugin.h SWITCH2/SWITCH2Plugin.h SEG7/SEG7.h LED/LED.h SWITCH/SWITCH.h SWITCH2/SWITCH2.h $(DISTDIR)/
	$(COPY_FILE) --parents devices.cpp LED/LEDPlugin.cpp SEG7/SEG7Plugin.cpp SWITCH/SWITCHPlugin.cpp SWITCH2/SWITCH2Plugin.cpp SEG7/SEG7.cpp LED/LED.cpp SWITCH/SWITCH.cpp SWITCH2/SWITCH2.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) ../../lib/qt5/designer/$(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile.Debug


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all: debug/qrc_icons.cpp
compiler_rcc_clean:
	-$(DEL_FILE) debug/qrc_icons.cpp
debug/qrc_icons.cpp: icons.qrc \
		/usr/lib64/qt5/bin/rcc \
		LED/LED.png \
		SEG7/Display7Seg.png \
		SWITCH/Switch.png \
		SWITCH2/Switch2.png
	/usr/lib64/qt5/bin/rcc -name icons icons.qrc -o debug/qrc_icons.cpp

compiler_moc_predefs_make_all: debug/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) debug/moc_predefs.h
debug/moc_predefs.h: /usr/lib64/qt5/mkspecs/features/data/dummy.cpp
	g++ -pipe -Wno-unused-parameter -std=gnu++11 -g -Wall -W -dM -E -o debug/moc_predefs.h /usr/lib64/qt5/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all: debug/moc_devices.cpp debug/moc_LEDPlugin.cpp debug/moc_SEG7Plugin.cpp debug/moc_SWITCHPlugin.cpp debug/moc_SWITCH2Plugin.cpp debug/moc_SEG7.cpp debug/moc_LED.cpp debug/moc_SWITCH.cpp debug/moc_SWITCH2.cpp
compiler_moc_header_clean:
	-$(DEL_FILE) debug/moc_devices.cpp debug/moc_LEDPlugin.cpp debug/moc_SEG7Plugin.cpp debug/moc_SWITCHPlugin.cpp debug/moc_SWITCH2Plugin.cpp debug/moc_SEG7.cpp debug/moc_LED.cpp debug/moc_SWITCH.cpp debug/moc_SWITCH2.cpp
debug/moc_devices.cpp: devices.h \
		debug/moc_predefs.h \
		/usr/lib64/qt5/bin/moc
	/usr/lib64/qt5/bin/moc $(DEFINES) --include debug/moc_predefs.h -I/usr/lib64/qt5/mkspecs/linux-g++ -I/home/juergen/zilogz80-code/qvintage -I/home/juergen/zilogz80-code/qvintage/SEG7 -I/home/juergen/zilogz80-code/qvintage/LED -I/home/juergen/zilogz80-code/qvintage/SWITCH -I/home/juergen/zilogz80-code/qvintage/SWITCH2 -I/usr/include/qt5 -I/usr/include/qt5/QtDesigner -I/usr/include/qt5/QtUiPlugin -I/usr/include/qt5/QtWidgets -I/usr/include/qt5/QtGui -I/usr/include/qt5/QtXml -I/usr/include/qt5/QtCore -I/usr/include/c++/7 -I/usr/include/c++/7/x86_64-redhat-linux -I/usr/include/c++/7/backward -I/usr/lib/gcc/x86_64-redhat-linux/7/include -I/usr/local/include -I/usr/include devices.h -o debug/moc_devices.cpp

debug/moc_LEDPlugin.cpp: LED/LEDPlugin.h \
